 168:Core/Inc/main.h **** // Общие функции для основных трех режимов
 169:Core/Inc/main.h **** 
 170:Core/Inc/main.h **** // Обновление количества светодиодов при нажатии перв�
 171:Core/Inc/main.h **** void handle_first_button(void) {
 172:Core/Inc/main.h ****     // Увеличиваем количество светодиодов
 173:Core/Inc/main.h ****     leds_per_group++;
 174:Core/Inc/main.h ****     if (leds_per_group > 6) {
 175:Core/Inc/main.h ****         leds_per_group = 1;
 176:Core/Inc/main.h ****     }
 177:Core/Inc/main.h **** }
 178:Core/Inc/main.h **** 
 179:Core/Inc/main.h **** // Обновление состояния светодиодов при нажатии второ�
 180:Core/Inc/main.h **** void handle_second_button(void) {
 181:Core/Inc/main.h ****     // Специальный случай: если выбрано 6 светодиодов
 182:Core/Inc/main.h ****     if (leds_per_group == 6) {
 183:Core/Inc/main.h ****         static uint32_t all_leds_on = 0;
 184:Core/Inc/main.h ****         if (all_leds_on) {
 185:Core/Inc/main.h ****             clear_all_leds();
 186:Core/Inc/main.h ****             all_leds_on = 0;
 187:Core/Inc/main.h ****         } else {
 188:Core/Inc/main.h ****             set_all_leds();
 189:Core/Inc/main.h ****             all_leds_on = 1;
 190:Core/Inc/main.h ****         }
 191:Core/Inc/main.h ****         return;
 192:Core/Inc/main.h ****     }
 193:Core/Inc/main.h ****     
ARM GAS  C:\Users\User\AppData\Local\Temp\ccOd3EkB.s 			page 14


 194:Core/Inc/main.h ****     // Обычный режим работы
 195:Core/Inc/main.h ****     if (current_state == 0) {
 196:Core/Inc/main.h ****         // Режим включения светодиодов
 197:Core/Inc/main.h ****         for(uint32_t i = 0; i < leds_per_group; i++) {
 198:Core/Inc/main.h ****             if (current_position + i < 6) {
 199:Core/Inc/main.h ****                 set_led_state(current_position + i, 1);
 200:Core/Inc/main.h ****             }
 201:Core/Inc/main.h ****         }
 202:Core/Inc/main.h ****         
 203:Core/Inc/main.h ****         current_position += leds_per_group;
 204:Core/Inc/main.h ****         
 205:Core/Inc/main.h ****         // Если включили все светодиоды, переходим в режим 
 206:Core/Inc/main.h ****         if (current_position >= 6) {
 207:Core/Inc/main.h ****             current_state = 1;
 208:Core/Inc/main.h ****             current_position = 0;
 209:Core/Inc/main.h ****         }
 210:Core/Inc/main.h ****     } else {
 211:Core/Inc/main.h ****         // Режим выключения светодиодов
 212:Core/Inc/main.h ****         for(uint32_t i = 0; i < leds_per_group; i++) {
 213:Core/Inc/main.h ****             if (current_position + i < 6) {
 214:Core/Inc/main.h ****                 set_led_state(current_position + i, 0);
 215:Core/Inc/main.h ****             }
 216:Core/Inc/main.h ****         }
 217:Core/Inc/main.h ****         
 218:Core/Inc/main.h ****         current_position += leds_per_group;
 219:Core/Inc/main.h ****         
 220:Core/Inc/main.h ****         // Если выключили все светодиоды, переходим в режи�
 221:Core/Inc/main.h ****         if (current_position >= 6) {
 222:Core/Inc/main.h ****             current_state = 0;
 223:Core/Inc/main.h ****             current_position = 0;
 224:Core/Inc/main.h ****         }
 225:Core/Inc/main.h ****     }
 226:Core/Inc/main.h **** }
 227:Core/Inc/main.h **** 
 228:Core/Inc/main.h **** void handle_buttons(void) {
 229:Core/Inc/main.h ****     // Обработка кнопки 1 (PA0) - изменение количества свето
 230:Core/Inc/main.h ****     if (read_button1()) {
 231:Core/Inc/main.h ****         simple_delay(10000); // Антидребезг
 232:Core/Inc/main.h ****         if (read_button1() && !button1_pressed) {
 233:Core/Inc/main.h ****             button1_pressed = 1;
 234:Core/Inc/main.h ****             handle_first_button();
 235:Core/Inc/main.h ****         }
 236:Core/Inc/main.h ****     } else {
 237:Core/Inc/main.h ****         button1_pressed = 0;
 238:Core/Inc/main.h ****     }
 239:Core/Inc/main.h ****     
 240:Core/Inc/main.h ****     // Обработка кнопки 2 (PA1) - управление светодиодами
 241:Core/Inc/main.h ****     if (read_button2()) {
 242:Core/Inc/main.h ****         simple_delay(10000); // Антидребезг
