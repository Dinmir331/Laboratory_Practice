 108:Core/Inc/init.h ****     GPIOA->PUPDR |= (0x2 << GPIO_PUPDR_PUPD0_Pos); // Pull-down (10)
 109:Core/Inc/init.h ****     
 110:Core/Inc/init.h ****     // PA1 - включение/выключение светодиодов
 111:Core/Inc/init.h ****     GPIOA->MODER &= ~GPIO_MODER_MODER1_Msk;      // Input mode (00)
 112:Core/Inc/init.h ****     GPIOA->PUPDR &= ~GPIO_PUPDR_PUPD1_Msk;       // Clear
 113:Core/Inc/init.h ****     GPIOA->PUPDR |= (0x2 << GPIO_PUPDR_PUPD1_Pos); // Pull-down (10)
 114:Core/Inc/init.h **** }
