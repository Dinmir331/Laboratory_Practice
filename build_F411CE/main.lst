  19:Core/Inc/main.h **** void set_led_state(uint32_t led_index, uint32_t state) {
  20:Core/Inc/main.h ****     if (state) {
  21:Core/Inc/main.h ****         // Устанавливаем соответствующий бит в ODR (PA2-PA7)
  22:Core/Inc/main.h ****         // Включить светодиод
