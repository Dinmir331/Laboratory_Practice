 166:Core/Inc/main.h **** // Общие функции для основных трех режимов
 167:Core/Inc/main.h **** 
 168:Core/Inc/main.h **** // Обновление количества светодиодов при нажатии перв�
 169:Core/Inc/main.h **** void handle_first_button(void) {
 170:Core/Inc/main.h ****     // Увеличиваем количество светодиодов
 171:Core/Inc/main.h ****     leds_per_group++;
 172:Core/Inc/main.h ****     if (leds_per_group > 6) {
 173:Core/Inc/main.h ****         leds_per_group = 1;
 174:Core/Inc/main.h ****     }
 175:Core/Inc/main.h **** }
 176:Core/Inc/main.h **** 
 177:Core/Inc/main.h **** // Обновление состояния светодиодов при нажатии второ�
 178:Core/Inc/main.h **** void handle_second_button(void) {
 179:Core/Inc/main.h ****     // Специальный случай: если выбрано 6 светодиодов
 180:Core/Inc/main.h ****     if (leds_per_group == 6) {
 181:Core/Inc/main.h ****         static uint32_t all_leds_on = 0;
 182:Core/Inc/main.h ****         if (all_leds_on) {
 183:Core/Inc/main.h ****             clear_all_leds();
 184:Core/Inc/main.h ****             all_leds_on = 0;
 185:Core/Inc/main.h ****         } else {
 186:Core/Inc/main.h ****             set_all_leds();
 187:Core/Inc/main.h ****             all_leds_on = 1;
 188:Core/Inc/main.h ****         }
 189:Core/Inc/main.h ****         return;
 190:Core/Inc/main.h ****     }
 191:Core/Inc/main.h ****     
 192:Core/Inc/main.h ****     // Обычный режим работы
 193:Core/Inc/main.h ****     if (current_state == 0) {
 194:Core/Inc/main.h ****         // Режим включения светодиодов
 195:Core/Inc/main.h ****         for(uint32_t i = 0; i < leds_per_group; i++) {
 196:Core/Inc/main.h ****             if (current_position + i < 6) {
ARM GAS  C:\Users\User\AppData\Local\Temp\cchRx90b.s 			page 14


 197:Core/Inc/main.h ****                 set_led_state(current_position + i, 1);
 198:Core/Inc/main.h ****             }
 199:Core/Inc/main.h ****         }
 200:Core/Inc/main.h ****         
 201:Core/Inc/main.h ****         current_position += leds_per_group;
 202:Core/Inc/main.h ****         
 203:Core/Inc/main.h ****         // Если включили все светодиоды, переходим в режим 
 204:Core/Inc/main.h ****         if (current_position >= 6) {
 205:Core/Inc/main.h ****             current_state = 1;
 206:Core/Inc/main.h ****             current_position = 0;
 207:Core/Inc/main.h ****         }
 208:Core/Inc/main.h ****     } else {
 209:Core/Inc/main.h ****         // Режим выключения светодиодов
 210:Core/Inc/main.h ****         for(uint32_t i = 0; i < leds_per_group; i++) {
 211:Core/Inc/main.h ****             if (current_position + i < 6) {
 212:Core/Inc/main.h ****                 set_led_state(current_position + i, 0);
 213:Core/Inc/main.h ****             }
 214:Core/Inc/main.h ****         }
 215:Core/Inc/main.h ****         
 216:Core/Inc/main.h ****         current_position += leds_per_group;
 217:Core/Inc/main.h ****         
 218:Core/Inc/main.h ****         // Если выключили все светодиоды, переходим в режи�
 219:Core/Inc/main.h ****         if (current_position >= 6) {
 220:Core/Inc/main.h ****             current_state = 0;
 221:Core/Inc/main.h ****             current_position = 0;
 222:Core/Inc/main.h ****         }
 223:Core/Inc/main.h ****     }
 224:Core/Inc/main.h **** }
 225:Core/Inc/main.h **** 
 226:Core/Inc/main.h **** void handle_buttons(void) {
 227:Core/Inc/main.h ****     // Обработка кнопки 1 (PA0) - изменение количества свето
 228:Core/Inc/main.h ****     if (read_button1()) {
 229:Core/Inc/main.h ****         simple_delay(10000); // Антидребезг
 230:Core/Inc/main.h ****         if (read_button1() && !button1_pressed) {
 231:Core/Inc/main.h ****             button1_pressed = 1;
 232:Core/Inc/main.h ****             handle_first_button();
 233:Core/Inc/main.h ****         }
 234:Core/Inc/main.h ****     } else {
 235:Core/Inc/main.h ****         button1_pressed = 0;
 236:Core/Inc/main.h ****     }
 237:Core/Inc/main.h ****     
 238:Core/Inc/main.h ****     // Обработка кнопки 2 (PA1) - управление светодиодами
 239:Core/Inc/main.h ****     if (read_button2()) {
 240:Core/Inc/main.h ****         simple_delay(10000); // Антидребезг
 241:Core/Inc/main.h ****         if (read_button2() && !button2_pressed) {
 242:Core/Inc/main.h ****             button2_pressed = 1;
 243:Core/Inc/main.h ****             handle_second_button();
 244:Core/Inc/main.h ****         }
 245:Core/Inc/main.h ****     } else {
 246:Core/Inc/main.h ****         button2_pressed = 0;
 247:Core/Inc/main.h ****     }
 248:Core/Inc/main.h **** }
 249:Core/Inc/main.h **** 
 250:Core/Inc/main.h **** #elif defined(ADD_TASK) // дополнительное задание
