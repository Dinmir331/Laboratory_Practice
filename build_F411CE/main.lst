  94:Core/Inc/init.h ****         // MODER - Output mode (01)
  95:Core/Inc/init.h ****         GPIOA->MODER |= (1UL << (2 * i));
  96:Core/Inc/init.h ****         // OTYPER - Push-Pull (0)
  97:Core/Inc/init.h ****         GPIOA->OTYPER &= ~(1UL << i);
  98:Core/Inc/init.h ****         // OSPEEDR - Medium speed (01)
  99:Core/Inc/init.h ****         GPIOA->OSPEEDR |= (1UL << (2 * i));
